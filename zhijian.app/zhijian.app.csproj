<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Zhijian.Core\Zhijian.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.3.0</Version>
    <Product>知笺</Product>
    <Description>本地优先的 Markdown 笔记与知识管理工具</Description>
    <ApplicationIcon Condition="Exists('Assets\zhijian.ico')">Assets\zhijian.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
